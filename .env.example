# Copy to .env next to docker-compose.yml. Everything here is optional:
# providers and models can also be configured in Settings after login.

# Fallback OpenAI-compatible provider when none is configured in Settings.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=

# Fallback Anthropic provider.
#ANTHROPIC_API_KEY=

# Overrides the default model (provider/model).
#HAHANESS_MODEL=

# Time zone for schedules.
#TZ=Asia/Ho_Chi_Minh

# Daily "new version" check. "off" disables it (intranet). Channel: stable or beta.
#HAHANESS_UPDATE_URL=off
#HAHANESS_UPDATE_CHANNEL=stable

# Marketplace catalog. "off" uses only the catalog.json bundled in the image.
#HAHANESS_CATALOG_URL=off
