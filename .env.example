# Copy to .env next to docker-compose.yml. Everything here is optional:
# providers and models can also be configured in Settings after login.

# Fallback OpenAI-compatible provider when none is configured in Settings.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=

# Fallback Anthropic provider.
#ANTHROPIC_API_KEY=

# Overrides the default model (provider/model).
#HAHANESS_MODEL=

# Time zone for schedules.
#TZ=Asia/Ho_Chi_Minh
