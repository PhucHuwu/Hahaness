{
  "name": "hahaness",
  "version": "0.1.0",
  "private": true,
  "description": "A virtual company run by AI agents for no-code users: you are the CEO, a CTO agent delegates to employee agents.",
  "keywords": ["ai-agents", "multi-agent", "llm", "agent-harness", "no-code", "mcp"],
  "homepage": "https://github.com/PhucHuwu/Hahaness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhucHuwu/Hahaness.git"
  },
  "bugs": {
    "url": "https://github.com/PhucHuwu/Hahaness/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "scripts": {
    "serve": "tsx src/server/index.ts",
    "ui": "tsx scripts/ui-dev.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
